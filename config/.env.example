# ============================================
# OpenClaw 环境变量模板
# 使用方法: cp .env.example .env 然后填入真实密钥
# ============================================

# ---- LLM 主力模型 ----
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---- LLM 小模型（路由/摘要等低成本场景）----
LLM_MINI_PROVIDER=openai
LLM_MINI_API_KEY=sk-your-api-key-here
LLM_MINI_BASE_URL=https://api.openai.com/v1
LLM_MINI_MODEL=gpt-4o-mini

# ---- Embedding 嵌入模型 ----
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large

# ---- LangSmith 全链路观测 ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-api-key-here
LANGCHAIN_PROJECT=openclaw-prod

# ---- Tavily 联网搜索 ----
TAVILY_API_KEY=tvly-your-api-key-here

# ---- RAG 知识库 ----
RAG_VECTOR_STORE_TYPE=chroma
RAG_VECTOR_STORE_PATH=./data/vector_db
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
RAG_TOP_K_RETRIEVE=10
RAG_TOP_K_RERANK=5
RAG_SIMILARITY_THRESHOLD=0.5

# ---- MCP 工具层 ----
MCP_TOOL_TIMEOUT=30
MCP_TOOL_MAX_RETRIES=3
MCP_CIRCUIT_BREAKER_THRESHOLD=5
MCP_CIRCUIT_BREAKER_RECOVERY=30

# ---- 分层记忆系统 ----
MEMORY_DB_PATH=./data/memory.db
MEMORY_SHORT_TERM_MAX_TOKENS=4000
MEMORY_LONG_TERM_TOP_K=5
MEMORY_SUMMARY_INTERVAL=10

# ---- FastAPI 服务 ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ---- Streamlit 前端 ----
STREAMLIT_PORT=8501
STREAMLIT_TITLE=OpenClaw 企业智能助手

# ---- 审计日志 ----
AUDIT_LOG_PATH=./data/audit_logs
AUDIT_LOG_LEVEL=INFO

# ---- 安全沙箱 ----
FILE_SANDBOX_ROOT=./data/uploads
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg
MAX_UPLOAD_SIZE_MB=10
