# ============================================
# OpenClaw 生产环境 .env 模板（服务器专用）
# 使用方法：复制本文件到服务器后重命名为 .env，把 <...> 占位符全部替换
#   cp production.env.example .env
# ⚠️ 本文件不要提交到 GitHub；服务器上的 .env 权限设为 600
# ============================================

# ---- LLM 配置（DeepSeek）----
LLM_PROVIDER=openai
LLM_API_KEY=<DeepSeek新key>
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# 多模态视觉模型（按需填；不需要图片识别可整段留空）
LLM_VISION_MODEL=gpt-4o
LLM_VISION_BASE_URL=https://api.openai.com/v1
LLM_VISION_API_KEY=<OpenAI-key-如不需要留空>

# 备用 / 小模型（可复用同一个 DeepSeek key）
LLM_MINI_PROVIDER=openai
LLM_MINI_API_KEY=<DeepSeek新key>
LLM_MINI_BASE_URL=https://api.deepseek.com/v1
LLM_MINI_MODEL=deepseek-chat

# ---- Embedding（DashScope）----
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=<DashScope新key>
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ---- LangSmith 观测 ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<LangSmith新key>
LANGCHAIN_PROJECT=openclaw-prod

# ---- Tavily 联网搜索 ----
TAVILY_API_KEY=<Tavily新key>

# ---- RAG 配置 ----
RAG_VECTOR_STORE_TYPE=chroma
RAG_VECTOR_STORE_PATH=./data/vector_db
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
RAG_TOP_K_RETRIEVE=10
RAG_TOP_K_RERANK=5
RAG_SIMILARITY_THRESHOLD=0.5

# ---- MCP 工具配置 ----
MCP_TOOL_TIMEOUT=30
MCP_TOOL_MAX_RETRIES=3
MCP_CIRCUIT_BREAKER_THRESHOLD=5
MCP_CIRCUIT_BREAKER_RECOVERY=30

# ---- 记忆系统 ----
MEMORY_DB_PATH=./data/memory.db
MEMORY_SHORT_TERM_MAX_TOKENS=4000
MEMORY_LONG_TERM_TOP_K=5
MEMORY_SUMMARY_INTERVAL=10

# ---- API 服务 ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
OPENCLAW_LOG_FORMAT=json
OPENCLAW_VERSION=<git-commit-sha-或版本号>

# 允许跨域的前端来源：替换为你的真实域名
OPENCLAW_CORS_ORIGINS=https://app.<你的域名>

# ---- 限流 ----
OPENCLAW_RATE_LIMIT_ENABLED=true
OPENCLAW_RATE_LIMIT_PER_MINUTE=120
OPENCLAW_RATE_LIMIT_WINDOW_SECONDS=60

# ---- 认证（生产必须 apikey 或 both）----
OPENCLAW_AUTH_MODE=apikey
OPENCLAW_API_KEYS=<至少2个oc_开头的key，逗号分隔>
OPENCLAW_JWT_SECRET=<用 openssl rand -base64 48 生成，生产换新的>
OPENCLAW_JWT_EXPIRE_HOURS=24

# ---- Streamlit UI ----
STREAMLIT_PORT=8501
STREAMLIT_TITLE="OpenClaw企业智能助手"

# ---- 审计日志 ----
AUDIT_LOG_PATH=./data/audit_logs
AUDIT_LOG_LEVEL=INFO

# ---- 安全 ----
FILE_SANDBOX_ROOT=./data/uploads
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg
MAX_UPLOAD_SIZE_MB=10

# ---- 域名（Caddy 自动 HTTPS 用）----
OPENCLAW_DOMAIN=<api.你的域名>

# ---- Grafana（启用 monitoring 才需要）----
GRAFANA_ADMIN_PASSWORD=<强密码，别用admin>

# ---- 对象存储 OBS（异地备份用，可选）----
# OPENCLAW_OBS_ENDPOINT=<endpoint>
# OPENCLAW_OBS_BUCKET=<bucket>
# OPENCLAW_OBS_ACCESS_KEY=<access_key>
# OPENCLAW_OBS_SECRET_KEY=<secret_key>
# OPENCLAW_OBS_REGION=<region>
