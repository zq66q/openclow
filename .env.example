# ============================================================
# OpenClaw 环境变量模板
# ============================================================
# 复制为 .env 并填入实际值
# 切勿提交 .env 到版本控制
# ============================================================

# ── LLM 大模型 ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# 小模型（摘要/路由等低成本场景）
LLM_MINI_PROVIDER=openai
LLM_MINI_BASE_URL=https://api.openai.com/v1
LLM_MINI_MODEL=gpt-4o-mini

# ── Embedding 嵌入模型 ──
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── API 服务 ──
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── 认证 ──
# 认证模式: apikey | jwt | both | none
# 生产环境务必改为 apikey / jwt / both，禁止保留 none
OPENCLAW_AUTH_MODE=apikey
# API Key 列表（逗号分隔），apikey / both 模式下必须设置
# 可用 python -c "from src.auth.middleware import generate_api_key; print(generate_api_key())" 生成
OPENCLAW_API_KEYS=oc_xxxxxxxxxxxxxxxxxxxxxxxx
# JWT 签名密钥（至少 32 字节，仅 JWT 模式需要）
OPENCLAW_JWT_SECRET=
# JWT Token 有效期（小时）
OPENCLAW_JWT_EXPIRE_HOURS=24

# ── RAG 知识库 ──
RAG_VECTOR_STORE_TYPE=chroma
RAG_VECTOR_STORE_PATH=./data/vector_db
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
RAG_TOP_K_RETRIEVE=10
RAG_TOP_K_RERANK=5
RAG_SIMILARITY_THRESHOLD=0.5

# ── 记忆系统 ──
MEMORY_DB_PATH=./data/memory.db
MEMORY_SHORT_TERM_MAX_TOKENS=4000
MEMORY_LONG_TERM_TOP_K=5
MEMORY_SUMMARY_INTERVAL=10

# ── MCP 工具 ──
MCP_TOOL_TIMEOUT=30
MCP_TOOL_MAX_RETRIES=3
MCP_CIRCUIT_BREAKER_THRESHOLD=5
MCP_CIRCUIT_BREAKER_RECOVERY=30

# ── 前端 ──
STREAMLIT_PORT=8501
STREAMLIT_TITLE=OpenClaw 企业智能助手

# ── LangSmith 可观测性 ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-xxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=openclaw

# ── Tavily 搜索 ──
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 文件上传 ──
FILE_SANDBOX_ROOT=./data/uploads
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg
MAX_UPLOAD_SIZE_MB=10

# ── 审计日志 ──
AUDIT_LOG_PATH=./data/audit_logs
AUDIT_LOG_LEVEL=INFO
